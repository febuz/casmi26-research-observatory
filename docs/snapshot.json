  "glossary": [
    {
      "term_id": "BG001",
      "term": "Moleculaire identiteit",
      "definition": "Connectiviteit onder een gespecificeerde canonicalisatie. Vermeld metric-key én algoritmeversie."
    },
    {
      "term_id": "BG002",
      "term": "Structuurrepresentatie",
      "definition": "Aangeleverde of gegenereerde schrijfwijze, zoals SMILES. Verschillende representaties kunnen dezelfde wedstrijdidentiteit hebben."
    },
    {
      "term_id": "BG003",
      "term": "Spectrum",
      "definition": "Eén acquisitie met precursor, ionisatiecondities en fragmentpieken. Een spectrum is geen onafhankelijke moleculaire identiteit."
    },
    {
      "term_id": "BG004",
      "term": "Query",
      "definition": "Identificatievraag die één of meerdere spectra groepeert en één ranglijst oplevert."
    },
    {
      "term_id": "BG005",
      "term": "Adduct",
      "definition": "Geannoteerde ionvorm met bekende massaschuiving en lading, zoals [M+H]+. Een onparseerbare annotatie krijgt een foutstatus."
    },
    {
      "term_id": "BG006",
      "term": "Polariteit",
      "definition": "Positieve of negatieve ionmodus van de meting. Afleiden uit een ander spectrum van dezelfde stof vereist een aparte onderbouwing."
    },
    {
      "term_id": "BG007",
      "term": "Botsingsenergie",
      "definition": "Acquisitieconditie voor fragmentatie met vastgelegde eenheid. Een energielijst en haar gemiddelde zijn verschillende gegevens."
    },
    {
      "term_id": "BG008",
      "term": "Retentietijd",
      "definition": "Tijdpositie onder een concrete chromatografische methode. Overdracht tussen kolommen of gradiënten vraagt kalibratie."
    },
    {
      "term_id": "BG009",
      "term": "Meetbron",
      "definition": "Oorspronkelijk laboratorium of spectrumrepository. Onderscheid dit van de catalogus waaruit kandidaten komen."
    },
    {
      "term_id": "BG010",
      "term": "Bronrelease",
      "definition": "Gedateerde versie van oorspronkelijke gegevens met toegangs- en gebruiksvoorwaarden."
    },
    {
      "term_id": "BG011",
      "term": "Asset",
      "definition": "Concreet bestand of checkpoint met inhoudshash, formaat, omvang en locatie. Een slug alleen is onvoldoende identiteit."
    },
    {
      "term_id": "BG012",
      "term": "Datasetversie",
      "definition": "Vastgelegde bundel assets met een doel en bronmanifest. Publicatie verandert haar trainingsblootstelling niet."
    },
    {
      "term_id": "BG013",
      "term": "Lineage",
      "definition": "Herleidbare afleidingsrelaties tussen bron, transform, dataset, model, run en resultaat."
    },
    {
      "term_id": "BG014",
      "term": "Provenance",
      "definition": "Breder bewijs over oorsprong, auteur, licentie, tijdstip en bewerking. Lineage is een onderdeel hiervan."
    },
    {
      "term_id": "BG015",
      "term": "Kandidaat",
      "definition": "Eén mogelijke structuur voor een query. Een kandidaat is nog geen bevestigde identificatie."
    },
    {
      "term_id": "BG016",
      "term": "Kandidaatset",
      "definition": "Unieke identiteiten die de scorer voor een query ontvangt, met bronrelaties en generatorversie."
    },
    {
      "term_id": "BG017",
      "term": "Kandidaatdekking",
      "definition": "Aandeel evaluatie-identiteiten waarvan de waarheid beschikbaar is vóór uiteindelijke ranking. Leg de exacte selectiestap vast."
    },
    {
      "term_id": "BG018",
      "term": "Kandidaatdruk",
      "definition": "Aantal concurrerende structuren per query of massavenster. Meer kandidaten betekent niet automatisch hogere dekking."
    },
    {
      "term_id": "BG019",
      "term": "Isomeerconcurrentie",
      "definition": "Aantal concurrerende structuren met dezelfde relevante formule. Het totaal aantal massavensterkandidaten is een andere maat."
    },
    {
      "term_id": "BG020",
      "term": "Bibliotheekoverlap",
      "definition": "Aanwezigheid van dezelfde gevalideerde identiteit in een benoemde spectrale bibliotheekversie. Een hoge gelijkenisscore alleen bewijst deze overlap niet."
    },
    {
      "term_id": "BG021",
      "term": "Experimentele klasse",
      "definition": "Door een panelmasker bepaalde herkennings- of onbekendheidsconditie. Zij is geen gemeten stofklasse of vaststaand aandeel van de verborgen test."
    },
    {
      "term_id": "BG022",
      "term": "Scaffold",
      "definition": "Volgens een benoemde methode afgeleid moleculair skelet dat kan worden gebruikt voor splitsing. Een lege of acyclische scaffold vereist expliciete behandeling."
    },
    {
      "term_id": "BG023",
      "term": "TRAIN",
      "definition": "Identiteiten die het fitten van modelparameters beïnvloeden. Vermeld ook eventuele pretraining."
    },
    {
      "term_id": "BG024",
      "term": "DEV",
      "definition": "Data voor architectuur, drempel, feature- en modelselectie. Herhaald gebruik kan selectieoptimisme veroorzaken."
    },
    {
      "term_id": "BG025",
      "term": "CONFIRM",
      "definition": "Vooraf gereserveerde populatie voor een bevroren vergelijking. De onafhankelijke rol vervalt na gebruik voor keuzes."
    },
    {
      "term_id": "BG026",
      "term": "Blootstelling",
      "definition": "Gebruik van gegevens of uitkomsten in training, checkpointselectie, analyse of andere modelkeuzes. Leg doel en tijdstip vast."
    },
    {
      "term_id": "BG027",
      "term": "Datacontaminatie",
      "definition": "Ongewenste overdracht waardoor de beoordeling informatie bevat die voor de gekozen onbekendheid had moeten worden uitgesloten."
    },
    {
      "term_id": "BG028",
      "term": "Hindsight",
      "definition": "Achteraf gemaakte keuze of uitleg met kennis van een resultaat. Een vooraf bestaande formule kan alsnog adaptief voor een slot worden gekozen."
    },
    {
      "term_id": "BG029",
      "term": "Modelversie",
      "definition": "Combinatie van architectuur, gewichten, featureschema, code en trainingsherkomst."
    },
    {
      "term_id": "BG030",
      "term": "Ensemble",
      "definition": "Vastgelegde combinatie van voorspellers met gewichten of selectieregels. Het aantal notebooks bewijst geen foutdiversiteit."
    },
    {
      "term_id": "BG031",
      "term": "Run",
      "definition": "Eén uitvoering met inputversies, platform, instellingen en status. Een geslaagde uitvoercontrole bewijst geen nauwkeurigheidswinst."
    },
    {
      "term_id": "BG032",
      "term": "Fallback",
      "definition": "Expliciet gedocumenteerde vervangingsroute bij tijd-, input- of uitvoerproblemen. Rapporteer hoeveel queries hiervan gebruikmaakten."
    },
    {
      "term_id": "BG033",
      "term": "MRR@25",
      "definition": "Gemiddelde inverse rang van de eerste juiste identiteit binnen de eerste 25. Afwezig betekent nul bijdrage."
    },
    {
      "term_id": "BG034",
      "term": "Top-1",
      "definition": "Aandeel queries met de correcte identiteit op de eerste positie. Het is geen synoniem voor MRR."
    },
    {
      "term_id": "BG035",
      "term": "Recall@25",
      "definition": "Aandeel queries waarvan de juiste identiteit in de geëxporteerde eerste 25 aanwezig is."
    },
    {
      "term_id": "BG036",
      "term": "Fingerprint-RMSE",
      "definition": "Wortel van de gemiddelde gekwadrateerde fout van voorspelde bitkansen tegenover bitlabels op een beschreven populatie."
    },
    {
      "term_id": "BG037",
      "term": "Brier-score",
      "definition": "Gemiddelde gekwadrateerde kansfout. Bij dezelfde binaire fingerprintdefinitie is de fingerprint-RMSE de wortel hiervan."
    },
    {
      "term_id": "BG038",
      "term": "Robuustheid",
      "definition": "Prestatie onder vooraf vastgelegde plausibele verstoringen of domeinverschuivingen. Vermeld recept en referentiemeting."
    },
    {
      "term_id": "BG039",
      "term": "Causaal effect",
      "definition": "Verschil door een afgebakende ingreep onder expliciete aannamen en controles. Een versieverschil alleen identificeert dit effect niet."
    },
    {
      "term_id": "BG040",
      "term": "Ablatie",
      "definition": "Gecontroleerde vergelijking waarin een component of informatiebron volgens een vooraf gekozen ontwerp wordt weggelaten of gewijzigd."
    },
    {
      "term_id": "BG041",
      "term": "Preregistratie",
      "definition": "Vóór de relevante uitkomst vastgelegde hypothese, varianten en beslisregel met controleerbare chronologie. Een lokale datum alleen is beperkt bewijs."
    },
    {
      "term_id": "BG042",
      "term": "Promotiepoort",
      "definition": "Vooraf vastgelegde criteria voor doorstroom naar een volgende onderzoeks- of inzetfase. De hoogste waargenomen score hoeft de poort niet te halen."
    },
    {
      "term_id": "BG043",
      "term": "Officiële inzending",
      "definition": "Platformgeregistreerde modelbeoordeling met kernelversie en referentie. Een lokaal CSV-bestand is nog geen inzending."
    },
    {
      "term_id": "BG044",
      "term": "Publieke score",
      "definition": "Score op het door Kaggle publiek beoordeelde deel. Houd deze gescheiden van ontwikkel- en private resultaten."
    },
    {
      "term_id": "BG045",
      "term": "Private score",
      "definition": "Platformscore voor de verborgen eindbeoordeling. Deze kan na de wedstrijd een andere rangorde opleveren."
    },
    {
      "term_id": "BG046",
      "term": "Onbeslist",
      "definition": "Uitkomst waarbij de gegevens de vooraf gekozen beslisgrens niet voldoende onderscheiden. Het is geen gemeten nul-effect."
    },
    {
      "term_id": "BG047",
      "term": "Ontbrekende waarde",
      "definition": "Niet beschikbare of niet-toepasselijke meting met expliciete reden. Numerieke nul is alleen voor een daadwerkelijk berekende nul."
    },
    {
      "term_id": "BG048",
      "term": "Openbaar",
      "definition": "Zonder private toegang gedeelde asset. Dit verleent op zichzelf geen herdistributierecht of toestemming voor iedere gebruiksvorm."
    },
    {
      "term_id": "BG049",
      "term": "NIST-afleiding",
      "definition": "Asset of checkpoint dat inhoud of training ontleent aan een uitgesloten NIST-bron. Openbare beschikbaarheid van de afleiding neemt de herkomst niet weg."
    },
    {
      "term_id": "BG050",
      "term": "Bewijsclaim",
      "definition": "Afgebakende uitspraak met bron, bewijsstatus, toepassingsgebied en beperkingen. Een gesigneerd record borgt integriteit, niet de waarheid van de claim."
    }
  ],
